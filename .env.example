# Optional. Defaults to ./data/listo.sqlite
LISTO_DB_PATH=/absolute/path/to/listo.sqlite

# Canonical OAuth origin. Local browser aliases use this same scheme and port.
# Require HTTPS for a public deployment.
LISTO_ORIGIN=http://localhost:3000
# Required only for trusted local stdio MCP.
LISTO_MCP_USER=jdelman
# Pass LISTO_BOOTSTRAP_PASSWORD once to the accounts bootstrap command.
# Pass LISTO_ACCOUNT_PASSWORD to the accounts create command.
